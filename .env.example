# Choose the network before adding an RPC endpoint. New projects default to devnet.
# Valid values are devnet and mainnet. Keep this aligned with the endpoint below.
NEXT_PUBLIC_SOLANA_CLUSTER="devnet"

# A provider-neutral public RPC URL. Leave empty to use Solana's public endpoint
# for the selected cluster. Never put private keys or provider secrets here.
NEXT_PUBLIC_SOLANA_RPC_URL=""

# Existing projects can keep this public Helius endpoint variable. It selects
# mainnet when NEXT_PUBLIC_SOLANA_CLUSTER is unset. Prefer the variable above.
NEXT_PUBLIC_HELIUS_URL=""
